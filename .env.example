# Supabase > Connect > Transaction pooler (porta 6543).
# Codifique caracteres especiais da senha para URL. Use SSL verificado.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=verify-full
APP_TZ=America/Fortaleza
# Usados apenas pelo comando npm run db:admin, nunca no frontend.
ADMIN_USERNAME=admin
ADMIN_NAME=Coordenador Geral
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# Storage: somente no backend e no build da Vercel; nunca use prefixo VITE_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELA_CHAVE_SERVICE_ROLE_DO_SUPABASE
